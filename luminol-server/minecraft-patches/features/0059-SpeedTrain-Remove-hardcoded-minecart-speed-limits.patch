+
+        // SpeedTrain start - 恢复高速矿车的保存速度
+        // 在Entity.load中，速度被限制在10.0以内，我们需要重新恢复原始速度
+        input.read("Motion", Vec3.CODEC).ifPresent(savedMotion -> {
+            // 检查是否有任何轴的速度超过了10.0（被Entity.load重置的速度）
+            Vec3 currentMotion = this.getDeltaMovement();
+            boolean wasLimited = false;
+
+            // 如果当前速度为0但保存的速度不为0，说明被限制了
+            if ((currentMotion.x == 0.0 && savedMotion.x != 0.0 && Math.abs(savedMotion.x) > 10.0) ||
+                    (currentMotion.z == 0.0 && savedMotion.z != 0.0 && Math.abs(savedMotion.z) > 10.0)) {
+                wasLimited = true;
+            }
+
+            if (wasLimited) {
+                // 恢复原始的高速度（Y轴保持限制以避免无限飞行）
+                this.setDeltaMovement(
+                        savedMotion.x,
+                        Math.abs(savedMotion.y) > 10.0 ? 0.0 : savedMotion.y,
+                        savedMotion.z
+                );
+                this.hasImpulse = true;
+            }
+        });
+        // SpeedTrain end
     }
 
